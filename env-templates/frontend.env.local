# Copy to CDC/frontend/.env.local
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
NEXTAUTH_URL=http://127.0.0.1:3000
# Generate a new one: openssl rand -base64 32
NEXTAUTH_SECRET=
# SEC-008: same value as INTERNAL_PROXY_SECRET in backend/.env (openssl rand -hex 32). Server-only, never NEXT_PUBLIC_.
INTERNAL_PROXY_SECRET=
# How many reverse proxies in front of Next.js append to X-Forwarded-For (production behind nginx: 1).
CLIENT_IP_PROXY_HOPS=1
