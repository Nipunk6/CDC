# Copy to CDC/backend/.env, then run: php artisan key:generate
APP_NAME="IIT ISM CDC Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000
FRONTEND_URLS=http://127.0.0.1:3000,http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
COMPANY_RECRUITER_VERIFY_TTL_MINUTES=30
PHP_CLI_SERVER_WORKERS=4

# SEC-008: same value as INTERNAL_PROXY_SECRET in frontend/.env.local (openssl rand -hex 32)
INTERNAL_PROXY_SECRET=
# SEC-007: extra host names for this API besides APP_URL's host (comma-separated, exact). Checked outside local/testing.
TRUSTED_HOSTS=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (keep DB_CONNECTION=mysql even on MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iitism_placement
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Local/testing: "log" writes emails to storage/logs/laravel.log instead of sending them.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="cdc@example.test"
MAIL_FROM_NAME="IIT ISM CDC Portal"
MAIL_BULK_BATCH_SIZE=100

# Optional
# STUDENT_EMAIL_DOMAINS=iitism.ac.in
# STUDENT_IMPORT_MAX_ROWS=10000

# First super admin, created by: php artisan migrate --seed
ADMIN_EMAIL=admin@example.test
ADMIN_NAME="CDC Admin"
ADMIN_PASSWORD=<choose-your-own-password>
